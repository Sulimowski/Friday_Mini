      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="BASE_S.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="BASE_S.stl"/>
      </geometry>
    </collision>
  </link>

